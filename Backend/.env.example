#SERVER SETUP
MONGO_URL="mongodb url"
DATABASE="Mongodb database"
PORT=5000

#TOKEN SECRET KEY
SECRET_JWT_KEY="JWT secret key"

#ENCRYPTION
ENCRYPTION_ALGORITHM="encryption algorithm"
ENCRYPT_KEY="key for encryptiong"

#MAILING
EMAIL="google gmail account for email service"
MAILPASS="google account mail password"

FRONTEND_URL="url of frontend"


#POST ON FACEBOOK
FACEBOOK_BASE_URL=https://graph.facebook.com/v22.0 (Facebook endpoint of graph api)
FACEBOOK_PAGE_ACCESS_TOKEN="FB-Page Access-Token"
FACEBOOK_PAGE_ID="FB-Page-ID form graph api"


#POST ON INSTAGRAM
INSTAGRAM_BASE_URL=https://graph.facebook.com/v22.0 (Facebook endpoint of graph api)
INSTAGRAM_ID="IG-ID from graph api"

#HUGGING FACE KEY
GEMINI_API_KEY="Gemini api key"


#OPENAI KEY AND URL
OPENAI_API_KEY="openai api key"
OPENAI_EMBEDDING_URL="openai api for embedding"

#AWS SQS CONFIGURATION
AWS_REGION="aws region (e.g., us-east-1)"
AWS_ACCESS_KEY_ID="aws access key id"
AWS_SECRET_ACCESS_KEY="aws secret access key"
AWS_SQS_QUEUE_URL="sqs queue url"
# Optional: Separate queues for each platform (if not set, uses AWS_SQS_QUEUE_URL)
AWS_SQS_FACEBOOK_QUEUE_URL="facebook specific queue url (optional)"
AWS_SQS_INSTAGRAM_QUEUE_URL="instagram specific queue url (optional)"